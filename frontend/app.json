{
  "expo": {
    "name": "VoiceLedger",
    "slug": "voiceledger",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0e17"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e17"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
