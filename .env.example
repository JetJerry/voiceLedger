# VoiceLedger Environment Variables Template

# App Configuration
PROJECT_NAME=VoiceLedger
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Default: SQLite (Zero config, local file)
DATABASE_URL=sqlite:///./voiceledger.db
# For PostgreSQL (Docker or Cloud):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceledger

# Razorpay Test Mode API Credentials
# Get these from: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
# Webhook secret set in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# AI / LLM Configuration
# Get your Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Default Merchant Context
DEFAULT_MERCHANT_NAME=Kirana & Cafe Express
