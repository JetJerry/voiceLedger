# VoiceLedger — Environment Configuration Template
# Copy this file to .env and configure the appropriate values for your environment.
# NEVER commit real credentials, production secrets, or private keys to source control.

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL is authoritative source of truth)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voiceledger

# Redis Configuration (For event queue, workers, and caching)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Razorpay Provider Credentials (MVP Payment Provider)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Network & CORS Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
