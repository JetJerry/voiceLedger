# ============================================================
# VoiceLedger Environment Configuration
# ============================================================

# Application
PROJECT_NAME=VoiceLedger
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ============================================================
# Database
# ============================================================

# Local/non-Docker:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voiceledger

# Docker Compose:
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/voiceledger

# ============================================================
# Redis
# ============================================================

REDIS_URL=redis://redis:6379/0

# ============================================================
# Authentication & Security
# ============================================================

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ============================================================
# Razorpay - TEST MODE
# ============================================================

# Razorpay Test Mode API Credentials
# Get these from: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
# Webhook secret set in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# ============================================================
# LLM / AI
# ============================================================

# Primary provider
LLM_PROVIDER=groq

GROQ_API_KEY=gsk_placeholder_groq_api_key_here

# Fallback provider
GEMINI_API_KEY=placeholder_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ============================================================
# LangSmith Observability
# ============================================================

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_placeholder_langsmith_api_key_here
LANGCHAIN_PROJECT=VoiceLedger
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============================================================
# Speech
# ============================================================

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

HF_TTS_MODEL=facebook/mms-tts-hin

# ============================================================
# CORS
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================
# Worker
# ============================================================

# Docker Compose uses a separate worker container.
# Therefore the API container should NOT start another worker.
RUN_WORKER=false